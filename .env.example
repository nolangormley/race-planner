# Copy this file to .env (and/or .env.dev for local overrides) and fill in
# real values. Never commit the filled-in file — .env and .env.* are
# gitignored except for this one.

# ---- Strava OAuth (https://www.strava.com/settings/api) ----
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Used by the src/pipeline.py CLI ingestion script (single-tenant refresh token).
STRAVA_REFRESH_TOKEN=

# ---- LLM provider (pick one) ----
# groq | deepseek | gemini | local (LM Studio)
LLM_PROVIDER=groq
GROQ_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# ---- Session security ----
# Signs the session cookie. Required for real deployments — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Keep it secret and stable; rotating it logs everyone out. If unset, the
# app generates a random one at startup and prints a warning (fine for a
# quick local test, not for anything shared/persistent).
SECRET_KEY=
# true when served over HTTPS (e.g. Render); false for local http://localhost dev.
SECURE_COOKIES=false

# ---- Email (password reset links) ----
# SMTP server used to send "forgot password" emails. Port 465 uses implicit
# TLS; any other port upgrades with STARTTLS. If SMTP_HOST is unset, reset
# emails are printed to the server log instead of sent (fine for local dev).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# From address; defaults to SMTP_USERNAME.
SMTP_FROM=

# ---- CORS ----
# Comma-separated list of origins allowed to make credentialed requests.
# Defaults to http://localhost:8000 if unset.
ALLOWED_ORIGINS=http://localhost:8000

# ---- Database ----
# Postgres connection string for the app/user database (SQLAlchemy).
DATABASE_URL=postgresql://user:password@localhost:5432/raceplanner
# Path to the DuckDB analytics warehouse populated by src/pipeline.py.
DB_PATH=data/strava_warehouse.duckdb

# ---- Misc ----
# Public base URL of this deployment, used to build the Strava OAuth redirect
# and the links in password reset emails.
HOST_URL=http://localhost:8000

# ---- Strava webhooks (optional) ----
# With a push subscription, Strava calls /api/strava/webhook when an activity
# is created, updated or deleted, and the warehouse syncs itself. Pick any
# secret string; scripts/strava_webhook.py uses it to register the
# subscription and the app uses it to answer Strava's validation request.
STRAVA_WEBHOOK_VERIFY_TOKEN=
